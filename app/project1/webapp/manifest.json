{
  "_version": "1.85.0",
  "sap.app": {
    "id": "project1",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.25.0",
      "toolsId": "f22d9269-8cf7-4b12-b23b-5021363b8a97"
    },
    "dataSources": {
      "mainService": {
        "uri": "/steckbrief/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.148.1",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "project1.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "FoerderprogrammeList",
          "target": "FoerderprogrammeList"
        },
        {
          "pattern": "Foerderprogramme({key}):?query:",
          "name": "FoerderprogrammeObjectPage",
          "target": "FoerderprogrammeObjectPage"
        },
        {
          "pattern": "Foerderprogramme({key})/finanzpositionen({key2}):?query:",
          "name": "FinanzpositionenObjectPage",
          "target": "FinanzpositionenObjectPage"
        }
      ],
      "targets": {
        "FoerderprogrammeList": {
          "type": "Component",
          "id": "FoerderprogrammeList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Foerderprogramme",
              "variantManagement": "Page",
              "navigation": {
                "Foerderprogramme": {
                  "detail": {
                    "route": "FoerderprogrammeObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  },
                  "actions": {
                    "GeneratePDFAction": {
                      "press": "project1.ext.controller.ListReportExt.downloadPDF",
                      "visible": true,
                      "enabled": true,
                      "text": "PDF generieren"
                    }
                  }
                }
              }
            }
          }
        },
        "FoerderprogrammeObjectPage": {
          "type": "Component",
          "id": "FoerderprogrammeObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Foerderprogramme",
              "navigation": {
                "finanzpositionen": {
                  "detail": {
                    "route": "FinanzpositionenObjectPage"
                  }
                }
              },
              "controllerExtensions": {
                "sap.fe.templates.ObjectPage": {
                  "controllerName": "project1.ext.controller.ObjectPageExt"
                }
              },
              "content": {
                "header": {
                  "actions": {
                    "GeneratePDFAction": {
                      "press": "project1.ext.controller.ObjectPageExt.downloadPDF",
                      "visible": true,
                      "enabled": true,
                      "text": "PDF generieren"
                    }
                  }
                }
              }
            }
          }
        },
        "FinanzpositionenObjectPage": {
          "type": "Component",
          "id": "FinanzpositionenObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Foerderprogramme/finanzpositionen"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}